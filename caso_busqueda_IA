:- dynamic estudiante/3, hash_personal/1, ruta_cerrada/2.

% El hash se calcula a partir de la matricula:
% (suma de sus digitos) x 7 + 13
hash_esperado(Matricula, Hash) :-
    atom_codes(Matricula, Codigos),
    include([C]&gt;&gt;(C &gt;= 0'0, C =&lt; 0'9), Codigos, Digitos),
    foldl([C, A0, A]&gt;&gt;(A is A0 + C - 0'0), Digitos, 0, Suma),
    Hash is Suma * 7 + 13.

validar_integridad :-
    (   estudiante(_, _, Mat)
    -&gt;  true
    ;   write('ERROR: completa tus datos en el BLOQUE 2'), nl, fail ),
    (   hash_personal(H)
    -&gt;  true
    ;   write('ERROR: falta tu hash en el BLOQUE 2'), nl, fail ),
    hash_esperado(Mat, HE),
    (   H =:= HE
    -&gt;  write('Validacion de integridad: OK'), nl
    ;   format('ERROR: tu hash (~w) no corresponde a tu matricula. Revisa el calculo.~n', [H]),
        fail ).

marca_agua('GSE-2026-A4-IA').</pre></div>
