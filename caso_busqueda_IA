  <div class="step"><span class="n">4</span><div>
    <h3>Búsqueda y recorrido <span class="pill lock">No editable</span></h3>
    <p>La búsqueda en anchura de todas las rutas, las reglas para recorrer una secuencia de tramos y las reglas para elegir la más barata o la más rápida.</p>
    <div class="codebox"><div class="codebar"><span>Bloque 4</span><button class="copy" data-target="g4">Copiar</button></div><pre id="g4">% =====================================================================
% BLOQUE 4: REGLAS DE BUSQUEDA Y DE RECORRIDO  -  NO MODIFICAR
% =====================================================================

% --- Busqueda en anchura (BFS) de TODAS las rutas sin ciclos ---
% rutas_bfs(+Origen, +Destino, -Rutas, -NodosExpandidos)
% Las rutas salen ordenadas por numero de tramos (primero las mas cortas).
rutas_bfs(Origen, Destino, Rutas, N) :-
    bfs_todas([[Origen]], Destino, [], RutasRev, 0, N),
    reverse(RutasRev, Rutas).

bfs_todas([], _, Acc, Acc, N, N).
bfs_todas([[Destino|Resto]|Cola], Destino, Acc, Rutas, N0, N) :- !,
    reverse([Destino|Resto], Ruta),
    bfs_todas(Cola, Destino, [Ruta|Acc], Rutas, N0, N).
bfs_todas([[Actual|Resto]|Cola], Destino, Acc, Rutas, N0, N) :-
    N1 is N0 + 1,
    findall([Sig, Actual|Resto],
            ( conexion(Actual, Sig, _, _),
              \+ memberchk(Sig, [Actual|Resto]) ),
            Hijos),
    append(Cola, Hijos, NuevaCola),
    bfs_todas(NuevaCola, Destino, Acc, Rutas, N1, N).

% --- Reglas para APLICAR una secuencia de tramos ---
% recorrer_ruta(+Ruta, -CostoTotal, -DiasTotal)
recorrer_ruta([_], 0, 0).
recorrer_ruta([A, B|Resto], Costo, Dias) :-
    conexion(A, B, C1, D1),
    recorrer_ruta([B|Resto], C2, D2),
    Costo is C1 + C2,
    Dias is D1 + D2.

ruta_valida(Ruta) :- recorrer_ruta(Ruta, _, _).

% --- Evaluacion y seleccion de rutas ---
evaluar_rutas(Rutas, Evaluadas) :-
    findall(r(C, D, R), ( member(R, Rutas), recorrer_ruta(R, C, D) ), Evaluadas).

mas_barata(Evaluadas, r(C, D, R)) :-
    findall(C0-D0-r(C0, D0, R0), member(r(C0, D0, R0), Evaluadas), L),
    msort(L, [_-_-r(C, D, R)|_]).

mas_rapida(Evaluadas, r(C, D, R)) :-
    findall(D0-C0-r(C0, D0, R0), member(r(C0, D0, R0), Evaluadas), L),
    msort(L, [_-_-r(C, D, R)|_]).

% Capacidad de una ruta = la del tramo mas angosto
capacidad_ruta([A, B], Cap) :- !, capacidad(A, B, Cap).
capacidad_ruta([A, B|Resto], Cap) :-
    capacidad(A, B, C1),
    capacidad_ruta([B|Resto], C2),
    Cap is min(C1, C2).</pre></div>
