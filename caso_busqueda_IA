  <p>Cada situación del cuarto es un estado: <code>estado(PosicionMono, piso|sobre_caja, PosicionCaja, no_tiene|tiene)</code>. Copia el programa, cárgalo y prueba las consultas.</p>
  <div class="codebox"><div class="codebar"><span>mono_clase.pl · programa de clase</span><button class="copy" data-target="mono">Copiar</button></div><pre id="mono">% =====================================================================
% ACTIVIDAD 4 - EL MONO Y EL PLATANO (Inteligencia Artificial, SABES)
% BLOQUE 1: CODIGO BASE  -  NO MODIFICAR
% =====================================================================
:- dynamic bloqueada/1, costo/2.

% --- Posiciones del cuarto ---
posicion(puerta).
posicion(ventana).
posicion(centro).
posicion(esquina).
posicion(estante).

permitida(P) :- posicion(P), \+ bloqueada(P).

% --- Representacion del estado ---
% estado(PosMono, AlturaMono, PosCaja, Platano)
%   AlturaMono: piso | sobre_caja      Platano: no_tiene | tiene

% --- Meta ---
es_meta(estado(_, _, _, tiene)).

% --- REGLAS DE LAS ACCIONES DEL MONO ---
% accion(Accion, EstadoAntes, EstadoDespues)
accion(agarrar,
       estado(P, sobre_caja, P, no_tiene),
       estado(P, sobre_caja, P, tiene)) :-
    platano_en(P).
accion(subir,
       estado(P, piso, P, H),
       estado(P, sobre_caja, P, H)).
accion(empujar(P1, P2),
       estado(P1, piso, P1, H),
       estado(P2, piso, P2, H)) :-
    permitida(P2), P1 \== P2.
accion(caminar(P1, P2),
       estado(P1, piso, C, H),
       estado(P2, piso, C, H)) :-
    permitida(P2), P1 \== P2.

% --- REGLAS PARA APLICAR UNA SECUENCIA DE ACCIONES ---
aplicar_secuencia(E, [], E).
aplicar_secuencia(E, [A|As], EFinal) :-
    accion(A, E, E1),
    aplicar_secuencia(E1, As, EFinal).

% --- REGLAS DE BUSQUEDA: primero en anchura (BFS) ---
% buscar_bfs(+Inicio, -Plan, -NodosExpandidos)
buscar_bfs(Inicio, Plan, N) :-
    bfs([nodo(Inicio, [])], [Inicio], 0, PlanRev, N),
    reverse(PlanRev, Plan).

bfs([nodo(E, Acc)|_], _, N0, Acc, N) :-
    es_meta(E), !, N is N0 + 1.
bfs([nodo(E, Acc)|Resto], Vis, N0, Plan, N) :-
    N1 is N0 + 1,
    findall(nodo(E2, [A|Acc]),
            ( accion(A, E, E2), \+ memberchk(E2, Vis) ),
            Hijos),
    findall(E2, member(nodo(E2, _), Hijos), Nuevos),
    append(Vis, Nuevos, Vis2),
    append(Resto, Hijos, Cola),
    bfs(Cola, Vis2, N1, Plan, N).

% --- REGLAS DE BUSQUEDA: primero en profundidad con limite (DFS) ---
% buscar_dfs(+Inicio, +Limite, -Plan)
buscar_dfs(Inicio, Limite, Plan) :-
    dfs(Inicio, [Inicio], Limite, Plan).

dfs(E, _, _, []) :- es_meta(E), !.
dfs(E, Vis, L, [A|Plan]) :-
    L &gt; 0,
    accion(A, E, E2),
    \+ memberchk(E2, Vis),
    L1 is L - 1,
    dfs(E2, [E2|Vis], L1, Plan).

% --- Programa principal ---
resolver :-
    estado_inicial(E0),
    platano_en(PP),
    mostrar_datos_estudiante,
    format('Estado inicial : ~w~n', [E0]),
    format('Platano colgado en: ~w~n~n', [PP]),
    (   buscar_bfs(E0, Plan, N)
    -&gt;  length(Plan, Pasos),
        write('Secuencia encontrada (BFS):'), nl,
        mostrar_plan(Plan, 1),
        aplicar_secuencia(E0, Plan, EF),
        format('~nEstado final   : ~w~n', [EF]),
        format('Numero de acciones: ~w~n', [Pasos]),
        format('Nodos expandidos  : ~w~n', [N])
    ;   write('No existe solucion con las restricciones actuales.'), nl
    ).

mostrar_plan([], _).
mostrar_plan([A|As], I) :-
    format('  ~w. ~w~n', [I, A]),
    I1 is I + 1,
    mostrar_plan(As, I1).

mostrar_datos_estudiante :-
    estudiante(Ap, Nom, Mat),
    write('=============================================='), nl,
    format('Estudiante: ~w ~w~nMatricula : ~w~n', [Nom, Ap, Mat]),
    write('=============================================='), nl.

% ==============================================
% DATOS DEL EJEMPLO DE CLASE
% ==============================================
estudiante('GRUPO', 'CALENTAMIENTO', 'SEMANA 4').
estado_inicial(estado(puerta, piso, esquina, no_tiene)).
platano_en(ventana).</pre></div>
  <div class="codebox"><div class="codebar"><span>Consultas en clase</span><button class="copy" data-target="qmono">Copiar</button></div><pre id="qmono">?- ['mono_clase'].

% 1. Buscar la secuencia con busqueda en anchura
?- resolver.

% 2. Aplicar una secuencia propuesta por ti y ver a que estado llega
?- estado_inicial(E),
   aplicar_secuencia(E, [caminar(puerta,esquina), empujar(esquina,ventana), subir, agarrar], F).

% 3. Que Prolog encuentre la secuencia mas corta sin usar el buscador
?- estado_inicial(E), between(1, 6, N), length(S, N),
   aplicar_secuencia(E, S, F), es_meta(F), !.

% 4. Busqueda en profundidad con limite de 6 acciones
?- estado_inicial(E), buscar_dfs(E, 6, Plan).</pre></div>
  <p class="note">Resultado esperado de <code>resolver.</code>: 4 acciones (caminar a la esquina, empujar la caja a la ventana, subir, agarrar) y 31 nodos expandidos. La consulta 4 devuelve un plan de 6 acciones: la búsqueda en profundidad no garantiza el camino más corto.</p>

