<script>
(function(){
  var DEST=['usa_miami','usa_miami','canada_toronto','canada_toronto','brasil_saopaulo','brasil_saopaulo','espana_madrid','espana_madrid','china_shanghai','china_shanghai'];
  var $=function(id){return document.getElementById(id)};
  function clean(s){return (s||'').replace(/'/g,'').trim().toUpperCase()}
  function update(){
    var ap=clean($('ap').value)||'APELLIDOS', nom=clean($('nom').value)||'NOMBRE', mat=clean($('mat').value)||'MATRICULA';
    var d=mat.replace(/\D/g,''), ok=d.length>=2;
    var last=ok?+d.charAt(d.length-1):0, pen=ok?+d.charAt(d.length-2):0;
    var suma=0; for(var i=0;i<d.length;i++){suma+=+d.charAt(i)}
    var hash=suma*7+13, dest=DEST[pen], paq=last===0?200:last*20;
    var prio=hash%2===0?'alta':'normal', reto=last<=3?'A':(last<=6?'B':'C');
    $('rDest').textContent=dest; $('rPaq').textContent=paq; $('rHash').textContent=hash; $('rPrio').textContent=prio; $('rReto').textContent=reto;
    $('rNota').textContent=ok?'Suma de dígitos: '+suma+'. Hash = '+suma+' × 7 + 13 = '+hash+'. Revisa este cálculo a mano en tu reporte.':'Escribe una matrícula con al menos dos dígitos.';
    ['A','B','C'].forEach(function(r){$('reto'+r).classList.toggle('mine',r===reto)});
    var ap1=ap.split(/\s+/)[0], f='a4_globalship_'+ap1+'_'+mat+'.pl';
    $('fname').textContent=f; $('fname2').textContent=f; $('fname3').textContent='A4_IA_'+ap1+'_'+mat+'.pdf';
    $('g2').textContent="% =====================================================================\n% BLOQUE 2: DATOS DEL ESTUDIANTE  -  COMPLETAR\n% =====================================================================\n"+
      "estudiante('"+ap+"', '"+nom+"', '"+mat+"').\n"+
      "% Hash = (suma de los digitos de la matricula) x 7 + 13 = "+suma+" x 7 + 13\n"+
      "hash_personal("+hash+").\n";
    $('g5').textContent="% =====================================================================\n% BLOQUE 5: MI ENVIO  -  COMPLETAR\n% =====================================================================\n"+
      "% Destino: penultimo digito ("+pen+") | Paquetes: ultimo digito ("+last+") x 20, si es 0 son 200\n"+
      "mi_envio(mexico_cdmx, "+dest+", "+paq+").\n";
    $('q').textContent="?- ['"+f.replace(/\.pl$/,'')+"'].\n\n"+
      "% 1. Sistema completo\n?- ejecutar_sistema.\n\n"+
      "% 2. Todas las rutas y los nodos expandidos\n?- rutas_bfs(mexico_cdmx, "+dest+", Rutas, Nodos).\n\n"+
      "% 3. Aplicar una secuencia de tramos propuesta por ti (cambiala por otra)\n"+
      "?- ruta_valida([mexico_cdmx, usa_miami, brasil_saopaulo]).\n"+
      "?- recorrer_ruta([mexico_cdmx, usa_miami, brasil_saopaulo], Costo, Dias).\n\n"+
      "% 4. Tu reto\n?- mi_reto.\n\n"+
      "% 5. Reporte completo\n?- generar_reporte.";
  }
  ['ap','nom','mat'].forEach(function(id){$(id).addEventListener('input',update)});
  document.querySelectorAll('button.copy').forEach(function(b){
    b.addEventListener('click',function(){
      var el=$(b.dataset.target), t=el.textContent;
      var done=function(){b.textContent='Copiado';setTimeout(function(){b.textContent='Copiar'},1500)};
      var fallback=function(){var r=document.createRange();r.selectNodeContents(el);var s=getSelection();s.removeAllRanges();s.addRange(r);b.textContent='Selecciona y copia'};
      try{navigator.clipboard.writeText(t).then(done,fallback)}catch(e){fallback()}
    });
  });
  update();
})();
</script>

